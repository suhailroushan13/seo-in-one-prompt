# ── Database ────────────────────────────────────────────────────────────────
# Orders, payment ledger, and pending prompts.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# ── Delivery email (Gmail app password) ─────────────────────────────────────
GMAIL_OWNER=<your-gmail-address>@gmail.com
GMAIL_APP_PASSWORD=<your-gmail-app-password>
# Fallback sender if GMAIL_OWNER is unset.
OWNER_EMAIL=<your-gmail-address>@gmail.com
# Sender display name on the delivery email.
SITE_NAME=SEO Prompt Generator

# ── Public site identity (inlined into the client bundle) ───────────────────
NEXT_PUBLIC_SITE_URL=https://seopromptai.com
NEXT_PUBLIC_SITE_NAME=SEO Prompt Generator

# ── Checkout ────────────────────────────────────────────────────────────────
# Hosted checkout link. The app appends redirect_url and metadata_orderId.
NEXT_PUBLIC_CHECKOUT_URL=https://dodo.pe/seopromptai
NEXT_PUBLIC_PRICE_AMOUNT=9
NEXT_PUBLIC_PRICE_CURRENCY=USD

# ── Payment webhook ─────────────────────────────────────────────────────────
# Standard Webhooks signing secret from the Dodo dashboard (starts with whsec_).
# Required: without it /api/payment/webhook rejects every request with 503.
DODO_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>
